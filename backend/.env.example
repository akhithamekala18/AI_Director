# =============================================================================
# AI Director — Backend Environment Variables
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env.
# =============================================================================

# --- Django Core (REQUIRED) -------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=0

# --- Database (REQUIRED) ----------------------------------------------------
DATABASE_URL=postgresql://ai_director:changeme@localhost:5432/ai_director

# --- Redis (REQUIRED) -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Credential Encryption (REQUIRED) ---------------------------------------
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-real-fernet-key

# --- AI Provider (REQUIRED) -------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60

# --- Publishing (OPTIONAL) --------------------------------------------------
PUBLISHING_ENABLED=0

# --- CORS (OPTIONAL) --------------------------------------------------------
CORS_ALLOWED_ORIGINS=

# --- SSL / HTTPS (OPTIONAL) -------------------------------------------------
DJANGO_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Logging (OPTIONAL) -----------------------------------------------------
LOG_LEVEL=WARNING

# --- Paths (OPTIONAL) -------------------------------------------------------
STATIC_ROOT=./staticfiles
MEDIA_ROOT=./media
